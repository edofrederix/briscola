{
    "version": 6,

    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "environment": {
                "FOAM_SIGFPE": "1",
                "FOAM_ABORT": "1"
            },
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "profile",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Profile"
            }
        }
    ],

    "buildPresets": [
        {
            "name": "debug-build-only",
            "configurePreset": "debug",
            "jobs": 0,
            "targets": ["all"]
        },
        {
            "name": "release-build-only",
            "configurePreset": "release",
            "jobs": 0,
            "targets": ["all"]
        },
        {
            "name": "profile-build-only",
            "configurePreset": "profile",
            "jobs": 0,
            "targets": ["all"]
        },

        {
            "name": "debug",
            "configurePreset": "debug",
            "jobs": 0,
            "targets": ["all", "install"]
        },
        {
            "name": "release",
            "configurePreset": "release",
            "jobs": 0,
            "targets": ["all", "install"]
        },
        {
            "name": "profile",
            "configurePreset": "profile",
            "jobs": 0,
            "targets": ["all", "install"]
        },

        {
            "name": "tests-debug",
            "configurePreset": "debug",
            "jobs": 0,
            "targets": ["all", "install", "tests"]
        },
        {
            "name": "tests-release",
            "configurePreset": "release",
            "jobs": 0,
            "targets": ["all", "install", "tests"]
        }
    ]
}
