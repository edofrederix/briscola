FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      briscolaTwoPhaseDict;
}

type    twoPhaseMultiVof;

source  (0 0 0); // set automatically by functionObject

g       (0 0 -9.81);

rho1    10;
rho2    1.204;
mu1     1e-5;
mu2     1.813e-7;

normalScheme
{
    type    MYC;
}

surfaceTensionScheme
{
    type    Brackbill;

    curvatureScheme
    {
        type    CV;
    }

    sigma   7.2e-4;
}

vof
{
    type    splitAdvection;
}

tagAlgorithm
{
    type    twoPass;
    minSize 27;
}
