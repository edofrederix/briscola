FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         10;

deltaT          0.0001;

writeControl    adjustableRunTime;

writeInterval   0.1;

writeFormat     binary;

writePrecision  6;

timeFormat      general;

timePrecision   6;

runTimeModifiable false;

adjustTimeStep  true;

maxCo           0.4;

libs
(
    "code/build/lib/libcode.so"
);

functions
{
    init
    {
        type    stratifiedFlow;
    }

    budgetPrimitives
    {
        type    budgetPrimitivesStaggeredTwoPhase;
        samplingSteps   10; // Update every 10 time steps to reduce computational cost
    }

    timeAverage
    {
        type    timeAverage;
        fields  (p Uc U fui1 fui2);
        startTime 0.1;
    }
}
